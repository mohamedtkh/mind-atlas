{
  "name": "mind-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "A calm, plain-language guide to mental health, with 3D views of how each topic can feel.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/content.test.mjs test/motion.test.mjs",
    "vendor": "node scripts/copy-vendor.mjs",
    "concepts": "python scripts/prepare-concepts.py",
    "titles": "node scripts/build-card-titles.mjs",
    "www": "node scripts/build-www.mjs",
    "android:apk": "node scripts/build-www.mjs && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}
